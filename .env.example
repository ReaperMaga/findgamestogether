# Kinde application credentials
NUXT_KINDE_CLIENT_ID=your_kinde_client_id
NUXT_KINDE_CLIENT_SECRET=your_kinde_client_secret
NUXT_KINDE_AUTH_DOMAIN=https://your-kinde-subdomain.kinde.com

# Local authentication redirects
NUXT_KINDE_REDIRECT_URL=http://localhost:3000/api/callback
NUXT_KINDE_LOGOUT_REDIRECT_URL=http://localhost:3000
NUXT_KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000

# Replace with a long, random value used to encrypt the session cookie
NUXT_KINDE_PASSWORD=replace_with_a_long_random_value
